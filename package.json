{
  "name": "sabaki",
  "productName": "Sabaki",
  "version": "0.60.2",
  "description": "An elegant Go/Baduk/Weiqi board and SGF editor for a more civilized age.",
  "author": "Yichuan Shen <shen.yichuan@gmail.com>",
  "homepage": "http://sabaki.yichuanshen.de",
  "license": "MIT",
  "main": "./src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/SabakiHQ/Sabaki"
  },
  "bugs": {
    "url": "https://github.com/SabakiHQ/Sabaki/issues"
  },
  "build": {
    "appId": "de.yichuanshen.sabaki",
    "copyright": "Copyright © 2015-2026 Yichuan Shen",
    "compression": "normal",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "toolsets": {
      "appimage": "1.0.2"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "artifactName": "sabaki-v${version}-linux-${arch}.${ext}"
    },
    "flatpak": {
      "runtimeVersion": "23.08",
      "baseVersion": "23.08",
      "finishArgs": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--filesystem=home",
        "--talk-name=org.freedesktop.Flatpak"
      ],
      "artifactName": "sabaki-v${version}-linux-${arch}-beta.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "notarize": true,
      "category": "public.app-category.board-games",
      "artifactName": "sabaki-v${version}-mac-${arch}.${ext}"
    },
    "win": {
      "artifactName": "sabaki-v${version}-win.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "sgf",
        "name": "SGF",
        "description": "Smart Game Format"
      },
      {
        "ext": "ngf",
        "name": "NGF",
        "description": "wBaduk NGF"
      },
      {
        "ext": "gib",
        "name": "GIB",
        "description": "Tygem GIB"
      },
      {
        "ext": "ugf",
        "name": "UGF",
        "description": "PandaNET UGF"
      }
    ],
    "files": [
      "**/*",
      "!**/{.github,.c9,scss,docs,test,tests,devtools,plugins,examples}${/*}",
      "!ci${/*}",
      "!src/components/{helpers,sidebars,bars}${/*}",
      "!src/modules${/*}",
      "!src/plugins${/*}",
      "!engines",
      "!node_modules",
      "node_modules/@primer/octicons/build/svg/*",
      "node_modules/@sabaki/deadstones/wasm/*",
      "node_modules/@sabaki/shudan/css/*",
      "node_modules/@sabaki/i18n/**/*",
      "node_modules/dolm/**/*",
      "node_modules/{iconv-lite,safer-buffer}/**/*",
      "node_modules/pikaday/css/*"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "bracketSpacing": false,
    "proseWrap": "always",
    "trailingComma": "all",
    "arrowParens": "always"
  },
  "dependencies": {
    "@huggingface/jinja": "^0.5.1",
    "@mariotacke/color-thief": "^3.0.1",
    "@primer/octicons": "^19.29.1",
    "@sabaki/boardmatcher": "^1.2.0",
    "@sabaki/deadstones": "^2.2.0",
    "@sabaki/go-board": "^1.4.1",
    "@sabaki/gtp": "^3.1.0",
    "@sabaki/i18n": "0.51.1-1",
    "@sabaki/immutable-gametree": "^1.9.4",
    "@sabaki/influence": "^1.2.2",
    "@sabaki/sgf": "^3.5.0",
    "@sabaki/shudan": "^1.7.1",
    "@xenova/transformers": "^2.17.2",
    "argv-split": "^3.2.1",
    "chromadb": "^3.1.6",
    "classnames": "^2.2.6",
    "cross-spawn": "^7.0.6",
    "dolm": "^0.7.3-beta",
    "execa": "^9.6.0",
    "figures": "^6.1.0",
    "fix-path": "<6.0.0",
    "iconv-lite": "^0.7.2",
    "is-plain-obj": "^4.1.0",
    "is-unicode-supported": "^2.1.0",
    "jschardet": "^3.0.0",
    "langchain": "^1.1.1",
    "llm-service-provider": "^3.9.0",
    "natsort": "^2.0.2",
    "node-fetch": "^3.3.2",
    "onnxruntime-common": "^1.23.2",
    "onnxruntime-web": "^1.23.2",
    "pikaday": "^1.8.0",
    "preact": "^10.27.2",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "rimraf": "^6.1.2",
    "shell-env": "^4.0.1",
    "shell-path": "^2.1.0",
    "uuid": "^14.0.1",
    "winston": "^3.2.1",
    "yoctocolors": "^2.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-env": "^7.28.5",
    "@playwright/test": "^1.58.0",
    "babel-loader": "^10.0.0",
    "concurrently": "^10.0.3",
    "copy-webpack-plugin": "^13.0.1",
    "crypto-browserify": "^3.12.1",
    "css-loader": "^7.1.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.8.1",
    "esm": "^3.2.25",
    "mocha": "^11.7.6",
    "onchange": "^7.1.0",
    "prettier": "3.8.1",
    "style-loader": "^4.0.0",
    "tmp": "^0.2.7",
    "tsx": "^4.23.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^6.0.1"
  },
  "scripts": {
    "dev-tools": "ELECTRON_ENABLE_LOGGING=1 electron --inspect=5858 --remote-debugging-port=9229 --auto-open-devtools-for-tabs ./",
    "test": "node run_tests.js",
    "start": "electron ./",
    "start-file": "electron ./ \"test/sgf/第3届衢州烂柯杯世界公开赛决赛3番棋3局.sgf\"",
    "dev": "ELECTRON_ENABLE_LOGGING=1 electron --inspect=5859 --remote-debugging-port=9230 ./",
    "bundle": "webpack --mode production",
    "build": "npm run bundle && electron-builder --dir",
    "create-release": "VERSION=$(node -p \"require('./package.json').version\") && ./scripts/create-release-custom.sh $VERSION auto-commit",
    "sync": "cnpm sync llm-service-provider",
    "update": "npm install llm-service-provider@latest",
    "create-release:custom": "./scripts/create-release-custom.sh $@",
    "format-base": "prettier \"**/*.{js,html,md}\" \"!{{dist,i18n}/**,bundle.js*}\"",
    "format-check": "npm run format-base -- --check",
    "format": "npm run format-base -- --write",
    "watch-format": "onchange \"**/*.{js,html,md}\" \"!{{dist,i18n}/**,bundle.js*}\" -- prettier --write {{changed}}",
    "watch": "concurrently \"webpack --mode development --watch\" \"npm run watch-format\"",
    "watch-dev": "concurrently \"webpack --mode development --watch\" \"wait-on bundle.js && npm run dev\"",
    "dist:macos": "npm run bundle && electron-builder -m --x64 --arm64 --publish never",
    "dist:linux": "npm run bundle && electron-builder -l --x64 --arm64 --publish never && node ./ci/normalizeArtifactNames.js",
    "dist:flatpak": "npm run bundle && electron-builder -l flatpak --x64 --publish never",
    "dist:win64": "npm run bundle && electron-builder -w --x64 --publish never && node ./ci/mv.js ./dist/sabaki-vx.x.x-win.exe ./dist/sabaki-vx.x.x-win-x64-setup.exe",
    "dist:win64-portable": "npm run bundle && electron-builder -w portable --x64 --publish never && node ./ci/mv.js ./dist/sabaki-vx.x.x-win.exe ./dist/sabaki-vx.x.x-win-x64-portable.exe",
    "dist:win": "npm run dist:win64 && npm run dist:win64-portable",
    "i18n": "node ./ci/createI18n.js",
    "gen:engine-transcripts": "node ./scripts/engine-transcripts/capture.mjs",
    "test:e2e": "webpack --mode development && (command -v xvfb-run >/dev/null 2>&1 && xvfb-run npx playwright test || npx playwright test)",
    "test:e2e:smoke": "webpack --mode development && (command -v xvfb-run >/dev/null 2>&1 && xvfb-run npx playwright test --project=smoke || npx playwright test --project=smoke)",
    "test:e2e:headed": "webpack --mode development && npx playwright test",
    "clear-cache": "rimraf node_modules/.cache && echo 'Кэш очищен'",
    "check-deps": "echo 'Проверка целостности зависимостей...' && npm ls --depth=0",
    "validate-deps": "echo 'Проверка установки зависимостей...' && npm ci"
  }
}
